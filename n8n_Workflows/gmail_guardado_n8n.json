    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const fullText = item.json.text || \"\";\n  const originalSubject = item.json.subject || \"\";\n  \n  let mensajeLimpio = fullText;\n\n  // Extraemos únicamente el cuerpo del mensaje tras la cabecera del reenvío\n  if (fullText.includes(\"Asunto:\")) {\n    const partes = fullText.split(/Asunto:.*(?:\\r?\\n)+/i);\n    if (partes.length > 1) {\n      mensajeLimpio = partes[1].trim();\n    }\n  } else if (fullText.includes(\"Subject:\")) {\n    const partes = fullText.split(/Subject:.*(?:\\r?\\n)+/i);\n    if (partes.length > 1) {\n      mensajeLimpio = partes[1].trim();\n    }\n  }\n\n  // Unimos el Subject original con el mensaje limpio\n  const textoCombinado = `Subject: ${originalSubject}\\n\\n${mensajeLimpio}`;\n\n  return {\n    json: {\n      texto_para_ai: textoCombinado,\n      subject: originalSubject,\n      mensaje_limpio: mensajeLimpio\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
