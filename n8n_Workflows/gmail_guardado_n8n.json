    {
      "parameters": {
        "jsCode": "\nconst total_dic={id:$('Gmail Trigger').first().json.id,\n                asunto:$('Gmail Trigger').first().json.headers.subject,\n                correo:$('Gmail Trigger').first().json.from.value[0].address,\n                emisor:$('Gmail Trigger').first().json.from.value[0].name,\n                contenido:$input.first().json.resumen_ia,\n                fecha:$('Gmail Trigger').first().json.headers.date,\n                catogoria1:$('Gmail Trigger').first().json.labelIds[1],\n                categoria2:$('Gmail Trigger').first().json.labelIds[2],\n                booleano:$input.first().json.importante};\nreturn total_dic"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
