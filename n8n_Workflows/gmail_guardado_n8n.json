      ],
      "id": "8c3b7637-85dd-4d3e-bc7e-14580d221c58",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// 1. Jalamos el texto sucio que viene en el \"output\"\nconst textoSucio = $input.first().json.output;\n\n// 2. Usamos la función mágica de JS para transformar un texto a JSON real\nconst datosLimpios = JSON.parse(textoSucio);\n\n// 3. Extraemos los valores limpios en variables listas\nconst miResumen = datosLimpios.text;\nconst esImportante = datosLimpios.bool;\n\n// 4. Se lo inyectamos al flujo de n8n para que las uses adelante\n$json.resumen_ia = miResumen;\n$json.importante = esImportante;\n\nreturn $json;"
      },
